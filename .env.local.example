# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). .env.local is gitignored.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: override the Google Analytics 4 Measurement ID (defaults to
# DinkManager's own, in src/lib/analytics.js). Only takes effect in
# production builds served from dinkmanager.com.
# VITE_GA_MEASUREMENT_ID=
